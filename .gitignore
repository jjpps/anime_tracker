# credenciais — o etp_rt da Crunchyroll e o client secret do AniList
.env
.env.*
!.env.example

# banco: contém o histórico de quem sincronizou, além do token do AniList
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

