crunchyroll.json
anilist_map.json
anilist_cache.json

# catálogo local do AniList (62 MB, baixado com `make db`)
.cache/

# python
.venv/
__pycache__/
*.pyc
*.egg-info/

# frontend (quando tiver build)
node_modules/
dist/

# editor e sistema
.vscode/
.idea/
.DS_Store
