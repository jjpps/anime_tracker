# Copie para .env e troque pelos valores reais. O .env está no .gitignore.
# Variável definida no shell tem prioridade sobre este arquivo.

# --- Crunchyroll ---
# Logado em crunchyroll.com: DevTools > Application > Cookies > copiar 'etp_rt'.
# É credencial de sessão: trate como senha.
CR_ETP_RT=00000000-0000-0000-0000-000000000000

# --- AniList ---
# anilist.co/settings/developer > Create New Application.
# A Redirect URL cadastrada tem que ser IDÊNTICA à de baixo.
# O client id é um inteiro curto e não é secreto; o secret é.
ANILIST_CLIENT_ID=12345
ANILIST_CLIENT_SECRET=troque-pelo-secret-real
ANILIST_REDIRECT_URI=http://localhost:8000/auth/anilist/callback

# --- app ---
ANIME_TRACKER_DB=anime_tracker.db
